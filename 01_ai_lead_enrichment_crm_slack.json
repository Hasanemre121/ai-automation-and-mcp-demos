{
  "name": "Demo 1 - AI Lead Qualification & CRM Sync (Portfolio Sample)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake-demo",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1a1b2c3d-0001-4000-8000-000000000001",
      "name": "Inbound Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "norm-1",
              "name": "lead_name",
              "value": "={{ $json.body?.name || $json.name || 'Sample Lead' }}",
              "type": "string"
            },
            {
              "id": "norm-2",
              "name": "lead_email",
              "value": "={{ $json.body?.email || $json.email || 'lead@example.com' }}",
              "type": "string"
            },
            {
              "id": "norm-3",
              "name": "company_size",
              "value": "={{ $json.body?.company_size || $json.company_size || '10-50' }}",
              "type": "string"
            },
            {
              "id": "norm-4",
              "name": "inquiry_text",
              "value": "={{ $json.body?.message || $json.message || 'Looking to automate CRM and reporting workflows.' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "1a1b2c3d-0002-4000-8000-000000000002",
      "name": "Normalize Lead Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a B2B lead qualification assistant. Return JSON with fields: score (1-100), priority (HIGH or NORMAL), summary (1 sentence), and suggested_reply (2 sentences).\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Lead: {{ $json.lead_name }} ({{ $json.lead_email }}), Size: {{ $json.company_size }}, Inquiry: {{ $json.inquiry_text }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "1a1b2c3d-0003-4000-8000-000000000003",
      "name": "AI Lead Scoring (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nlet parsed = { score: 85, priority: 'HIGH', summary: 'Qualified automation inquiry', suggested_reply: 'Thanks for reaching out! Let us review your workflow goals.' };\ntry {\n  const content = raw.choices?.[0]?.message?.content;\n  if (content) parsed = JSON.parse(content);\n} catch (e) {}\nreturn [{ json: { ...$('Normalize Lead Fields').first().json, ...parsed, processed_at: new Date().toISOString() } }];"
      },
      "id": "1a1b2c3d-0004-4000-8000-000000000004",
      "name": "Parse AI JSON Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-high",
              "leftValue": "={{ $json.priority }}",
              "rightValue": "HIGH",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a1b2c3d-0005-4000-8000-000000000005",
      "name": "Route by Priority",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#sales-alerts",
          "mode": "name"
        },
        "text": "=*High-Priority Lead Alert (Demo)*\n• *Name:* {{ $json.lead_name }} ({{ $json.lead_email }})\n• *Score:* {{ $json.score }}/100\n• *Summary:* {{ $json.summary }}\n• *Suggested Reply:* {{ $json.suggested_reply }}",
        "otherOptions": {}
      },
      "id": "1a1b2c3d-0006-4000-8000-000000000006",
      "name": "Notify Sales Channel (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1360, 200]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "DEMO_CRM_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "1a1b2c3d-0007-4000-8000-000000000007",
      "name": "Log Lead to Google Sheets CRM",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1360, 420]
    }
  ],
  "connections": {
    "Inbound Lead Webhook": {
      "main": [[{ "node": "Normalize Lead Fields", "type": "main", "index": 0 }]]
    },
    "Normalize Lead Fields": {
      "main": [[{ "node": "AI Lead Scoring (OpenAI)", "type": "main", "index": 0 }]]
    },
    "AI Lead Scoring (OpenAI)": {
      "main": [[{ "node": "Parse AI JSON Output", "type": "main", "index": 0 }]]
    },
    "Parse AI JSON Output": {
      "main": [[{ "node": "Route by Priority", "type": "main", "index": 0 }]]
    },
    "Route by Priority": {
      "main": [
        [
          { "node": "Notify Sales Channel (Slack)", "type": "main", "index": 0 },
          { "node": "Log Lead to Google Sheets CRM", "type": "main", "index": 0 }
        ],
        [
          { "node": "Log Lead to Google Sheets CRM", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
