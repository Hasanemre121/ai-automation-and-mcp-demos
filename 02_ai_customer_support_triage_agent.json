{
  "name": "Demo 2 - AI Customer Support Triage & Draft Reply (Portfolio Sample)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support-ticket-demo",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "2b1b2c3d-0001-4000-8000-000000000001",
      "name": "Incoming Support Ticket",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nreturn [{\n  json: {\n    ticket_id: body.ticket_id || 'TCK-' + Math.floor(1000 + Math.random() * 9000),\n    customer_email: body.email || 'customer@example.com',\n    subject: body.subject || 'Question about API integration',\n    message: body.message || 'Hi team, how do I connect our webhook to the reporting endpoint?',\n    received_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "2b1b2c3d-0002-4000-8000-000000000002",
      "name": "Validate & Tag Ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Classify the support ticket into category (TECHNICAL, BILLING, GENERAL), urgency (URGENT, STANDARD), and write a polite, accurate draft_reply. Return valid JSON.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Subject: {{ $json.subject }}\\nMessage: {{ $json.message }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "2b1b2c3d-0003-4000-8000-000000000003",
      "name": "AI Triage & Draft Generator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const ticket = $('Validate & Tag Ticket').first().json;\nlet ai = { category: 'TECHNICAL', urgency: 'STANDARD', draft_reply: 'Thank you for contacting support. Here are the webhook integration steps...' };\ntry {\n  const raw = $input.first().json.choices?.[0]?.message?.content;\n  if (raw) ai = JSON.parse(raw);\n} catch (e) {}\nreturn [{ json: { ...ticket, ...ai } }];"
      },
      "id": "2b1b2c3d-0004-4000-8000-000000000004",
      "name": "Merge Triage Metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "TECHNICAL",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Technical Queue"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "BILLING",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Billing Queue"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "2b1b2c3d-0005-4000-8000-000000000005",
      "name": "Route to Department Queue",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Incoming Support Ticket": {
      "main": [[{ "node": "Validate & Tag Ticket", "type": "main", "index": 0 }]]
    },
    "Validate & Tag Ticket": {
      "main": [[{ "node": "AI Triage & Draft Generator", "type": "main", "index": 0 }]]
    },
    "AI Triage & Draft Generator": {
      "main": [[{ "node": "Merge Triage Metadata", "type": "main", "index": 0 }]]
    },
    "Merge Triage Metadata": {
      "main": [[{ "node": "Route to Department Queue", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
